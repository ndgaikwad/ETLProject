      "boundElements": [],
      "updated": 1785018312038,
      "link": null,
      "locked": false,
      "text": "Metastore Admin (Highest Level)\n\nScope: Entire Unity Catalog metastore\n\nCan:\nCreate catalogs\nAssign catalog owners\nManage storage credentials and external locations\nGrant permissions on any securable object\nTransfer ownership\nView and manage all catalogs",
      "fontSize": 22.266143077902978,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Metastore Admin (Highest Level)\n\nScope: Entire Unity Catalog metastore\n\nCan:\nCreate catalogs\nAssign catalog owners\nManage storage credentials and external locations\nGrant permissions on any securable object\nTransfer ownership\nView and manage all catalogs",
      "autoResize": true,
      "lineHeight": 1.25
    },
