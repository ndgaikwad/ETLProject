      "locked": false,
      "text": "Catalog Owner\n\nScope: One catalog\n\nCan:\nCreate schemas\nGrant/revoke permissions within that catalog\nChange ownership of schemas/tables/views\nManage catalog settings",
      "fontSize": 22.266143077902978,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Catalog Owner\n\nScope: One catalog\n\nCan:\nCreate schemas\nGrant/revoke permissions within that catalog\nChange ownership of schemas/tables/views\nManage catalog settings",
